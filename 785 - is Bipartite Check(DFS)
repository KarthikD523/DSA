class Solution {
public boolean isCheckDFS(int v,int c,int[][] graph,int color[]){

     for(int it: graph[v]){
        if(color[it]==-1){
            color[it]=c;
            if(isCheckDFS(it,1-c,graph,color)==false)
              return false;
        }
        else if(color[it]==1-c)
          return false;
     }
     return true;

    }
    public boolean isBipartite(int[][] graph) {
        int[] color=new int[graph.length];
        for(int i=0;i<graph.length;i++){
            color[i]=-1;
        }

      
          for(int i=0;i<graph.length;i++){
            if(color[i]==-1){
                if(isCheckDFS(i,0,graph,color)==false)
                  return false;
            }
              
        }
        return true;
    }
}
