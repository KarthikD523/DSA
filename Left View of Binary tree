/* A Binary Tree node
class Node
{
    int data;
    Node left, right;

    Node(int item)
    {
        data = item;
        left = right = null;
    }
}*/
class Solution {
    public void f(Node node,int level,ArrayList<Integer> ds){
        if(node==null)
         return;
        if(level==ds.size())
          ds.add(node.data);
        f(node.left,level+1,ds);
        f(node.right,level+1,ds);
        
    }
    // Function to return list containing elements of left view of binary tree.
    ArrayList<Integer> leftView(Node root) {
        // code here
        ArrayList<Integer> ds=new ArrayList<>();
        f(root,0,ds);
        return ds;
    }
}
