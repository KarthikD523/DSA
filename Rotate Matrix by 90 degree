class Solution {
    public void rotate(int[][] matrix) {
        int n=matrix[0].length;//m==n         //Take transpose and reverse each row
        int m=matrix.length;
        for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){
                if(i<j){
                    int temp=matrix[i][j];
                    matrix[i][j]=matrix[j][i];
                    matrix[j][i]=temp;
                }
            }
        }
        for(int i=0;i<m;i++){
            int a=0;
            int b=matrix[i].length-1;
            while(a<b){
                int temp=matrix[i][a];
                matrix[i][a]=matrix[i][b];
                matrix[i][b]=temp;
                a++;
                b--;
            }
        }
    }
}
