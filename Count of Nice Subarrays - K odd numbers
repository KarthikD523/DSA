class Solution {
    public int count(int[] nums,int k){
          int l=0,r=0,sum=0;
        int cnt=0;
        while(r<nums.length){
            sum+=nums[r]%2;
            while(sum>k)
            {
                sum-=nums[l]%2;
                l++;
            }
            cnt+=(r-l+1);
            r++;
        }
        return cnt;
    }
    public int numberOfSubarrays(int[] nums, int k) {
      return count(nums,k)-count(nums,k-1);
    }
}
